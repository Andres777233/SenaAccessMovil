<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Aplica configuración por defecto: solo conexiones HTTPS permitidas -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Incluye solo certificados del sistema (sin certs de usuario/MITM) -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Permitir cleartext solo para localhost en modo debug -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain> <!-- Emulador Android -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>